# VoxWard Synthetic Sandbox Environment (NO production secrets allowed)
VOXWARD_ADAPTERS=synthetic
VOXWARD_SANDBOX_ENABLED=true
VOXWARD_SANDBOX_DB=data/voxward-sandbox.sqlite3
VOXWARD_SANDBOX_HOST=127.0.0.1
VOXWARD_SANDBOX_PORT=3100
# Do NOT set GOOGLE_CLIENT_SECRET, YOUTUBE_CLIENT_SECRET, YOUTUBE_REFRESH_TOKEN, or YOUTUBE_ACCESS_TOKEN.
