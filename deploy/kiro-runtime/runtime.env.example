# Template only. Copy it into the private environment of the runtime account, fill in values from the secret store, and
# never commit a filled copy. This repository installs nothing from this file.
# Names avoid the VOXWARD_ prefix on purpose: the server's config loader rejects unknown VOXWARD_ variables.

# Parent of the one-time run directories. Owned by the runtime account, mode 0700. Placeholder path.
KIRO_RUNTIME_ROOT=/var/lib/example-kiro-runtime/runtime

# HOME of the runtime account. Kiro CLI settings and login state are kept here. Placeholder path; the CLI path is unverified.
KIRO_RUNTIME_HOME=/var/lib/example-kiro-runtime/home

# Headless authentication, from the secret store. Empty here. Injection method is unverified.
KIRO_API_KEY=
