# Template only. Copy to a private server environment file (mode 0600, owned by the voxward service user)
# and never commit a filled copy. No real secrets or shared passwords belong here.

# Bind only to loopback behind a TLS-terminating reverse proxy (Caddy/Nginx).
VOXWARD_HOST=127.0.0.1
VOXWARD_PORT=3000

# Adapter set for the server build.
VOXWARD_ADAPTERS=synthetic

# SQLite WAL database on a local persistent volume (never a network filesystem).
VOXWARD_DATABASE_FILE=/var/lib/voxward/voxward.sqlite3

# Q37: Upper-bounded Kiro inference timeout in milliseconds (allowed: 1000..300000).
VOXWARD_KIRO_TIMEOUT_MS=120000

# Required before storing or decrypting adapter secrets (minimum 16 characters or 64-hex key).
# Generate on the server host with `openssl rand -hex 32` and keep it unset only for read-only/stateless runs.
# VOXWARD_VAULT_KEY=
