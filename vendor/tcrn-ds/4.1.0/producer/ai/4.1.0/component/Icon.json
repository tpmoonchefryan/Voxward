      "line": 133,
      "snippet": "case \"Icon\": return state === \"sizes\" ? ([\"sm\", \"md\", \"lg\"] as const).map(size => <Icon key={size} name=\"settings\" size={size} />)\n        : <Icon name=\"settings\" title={state === \"meaningful\" ? c.settings : undefined} />;",
      "sha256": "1a05a39101aa8dcba5263db42932bf5a118d6e23d5d6180e6bee5033799c3f90",
      "snippetKind": "producer scenario excerpt; helpers and imports are in the source module",
      "usage": "import { Icon, tcrnComponentCss } from \"@tcrn/ui-react/approved\";\nimport { tcrnTokenCss } from \"@tcrn/ui-tokens\";\nimport \"@tcrn/ui-tokens/fonts.css\";\n\nexport function Example() {\n  return <>\n    <style>{tcrnTokenCss + \"\\n\" + tcrnComponentCss}</style>\n    <div data-tcrn-root data-tcrn-theme=\"light\" style={{ display: \"grid\", gap: \"var(--tcrn-space-2)\" }}>\n      <Icon name=\"settings\" size=\"md\" title=\"Settings\"/>\n    </div>\n  </>;\n}\n",
