    "example": {
      "path": "apps/storybook/src/component-examples.tsx",
      "line": 146,
      "snippet": "case \"IconButton\": return state === \"sizes\" ? ([\"sm\", \"md\", \"lg\"] as const).map(size => <IconButton key={size} size={size} ariaLabel={c.settings} iconName=\"settings\" />) : <IconButton {...props} ariaLabel={c.settings} iconName=\"settings\" loading={state === \"loading\"} aria-pressed={state === \"selected\" || undefined} onClick={() => setFeedback(\"activated\")}>{state === \"labelled\" ? c.settings : undefined}</IconButton>;",
      "sha256": "1a05a39101aa8dcba5263db42932bf5a118d6e23d5d6180e6bee5033799c3f90",
      "snippetKind": "producer scenario excerpt; helpers and imports are in the source module",
      "usage": "import { IconButton, tcrnComponentCss } from \"@tcrn/ui-react/approved\";\nimport { tcrnTokenCss } from \"@tcrn/ui-tokens\";\nimport \"@tcrn/ui-tokens/fonts.css\";\n\nexport function Example() {\n  return <>\n    <style>{tcrnTokenCss + \"\\n\" + tcrnComponentCss}</style>\n    <div data-tcrn-root data-tcrn-theme=\"light\" style={{ display: \"grid\", justifyItems: \"start\", gap: \"var(--tcrn-space-2)\" }}>\n      <IconButton ariaLabel=\"Settings\" iconName=\"settings\">Settings</IconButton>\n    </div>\n  </>;\n}\n",
