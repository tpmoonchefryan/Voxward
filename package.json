{
  "name": "voxward",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && pnpm run bench:typecheck",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.mjs",
    "check:ds": "tcrn-ds-check --project apps/web --index vendor/tcrn-ds/4.2.0/ai/index.json --declaration .tcrn-ds.json",
    "bench:typecheck": "pnpm --filter @voxward/server exec tsc -p ../../bench/tsconfig.json",
    "bench:quality": "pnpm --filter @voxward/server exec tsx ../../bench/scripts/quality.ts",
    "bench:latency": "pnpm --filter @voxward/server exec tsx ../../bench/scripts/latency-capacity.ts",
    "bench:cleanup": "pnpm --filter @voxward/server exec tsx ../../bench/scripts/cleanup-observe.ts"
  },
  "devDependencies": {
    "@tcrn/ds-consumer-tools": "4.2.0",
    "vitest": "~4.1.11"
  }
}
